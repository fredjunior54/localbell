[Unit]
Description=LocalBell - Android notification forwarder
Documentation=https://github.com/fredjunior54/localbell
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStartPre=/bin/sh -c "until ip -4 -o addr show up | grep -Ev '^[0-9]+:[[:space:]]+lo[[:space:]]|[[:space:]]inet[[:space:]]+127[.]' | grep -q .; do sleep 1; done"
ExecStart=%h/.local/bin/localbell --start-minimized
TimeoutStartSec=15s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
